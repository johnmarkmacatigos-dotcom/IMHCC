# Copy to .env.local for local development, and add the same values in Netlify/Vercel settings.

# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public address of the website (used for SEO links)
NEXT_PUBLIC_SITE_URL=https://imhcc.netlify.app

# Optional: email alerts for new inquiries (free Resend account at resend.com)
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=owner@example.com
EMAIL_FROM=Iloilo Modern Homes <onboarding@resend.dev>
